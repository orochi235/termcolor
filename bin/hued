#!/usr/bin/env bash
# hued — manage terminal colors per directory

set -euo pipefail

HUED_VERSION="3.3.1"

_HUED_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Locate hued-names.sh across install layouts: repo root / manual install
# (alongside _HUED_DIR) and Homebrew (bin in <prefix>/bin, names in
# <prefix>/share).
_HUED_NAMES_FILE="$_HUED_DIR/hued-names.sh"
[[ -f "$_HUED_NAMES_FILE" ]] || _HUED_NAMES_FILE="$_HUED_DIR/share/hued-names.sh"

_hued_find() {
  local dir="$PWD"
  while [[ "$dir" != / && -n "$dir" ]]; do
    [[ -f "$dir/.hued" ]] && echo "$dir/.hued" && return 0
    dir="${dir%/*}"
  done
  return 1
}

_hued_normalize_color() {
  local bare="${1#\#}"

  # Expand 3-char shorthand to 6-char
  if [[ "$bare" =~ ^[0-9a-fA-F]{3}$ ]]; then
    bare="${bare:0:1}${bare:0:1}${bare:1:1}${bare:1:1}${bare:2:1}${bare:2:1}"
  fi

  # 6-char hex — normalize to lowercase #rrggbb
  if [[ "$bare" =~ ^[0-9a-fA-F]{6}$ ]]; then
    printf '#%s' "${bare,,}"
    return
  fi

  # Named color — resolve via hued-names.sh
  if [[ -f "$_HUED_NAMES_FILE" ]]; then
    local hex
    hex=$(grep -m1 "\[${bare}\]=" "$_HUED_NAMES_FILE" 2>/dev/null | cut -d= -f2)
    [[ -n "$hex" ]] && printf '%s' "$hex" && return
  fi

  printf '%s' "$1"
}

# Print a pastel fraction for an amount ("20", "20%", "+20%", "-20%").
# Prints its own error and returns 1 on failure.
_hued_amount() {
  local val="$1" n sign mag
  if [[ "$val" =~ ^([+-]?[0-9]+(\.[0-9]+)?)%$ ]]; then
    n="${BASH_REMATCH[1]}"
  elif [[ "$val" =~ ^([+-]?[0-9]+(\.[0-9]+)?)$ ]]; then
    n="${BASH_REMATCH[1]}"
    sign=""; mag="$n"
    if [[ "$mag" == [+-]* ]]; then sign="${mag:0:1}"; mag="${mag:1}"; fi
    if awk -v a="$mag" 'BEGIN{exit !(a>0 && a<1)}'; then
      echo "hued mod: $val is ambiguous — write \"$val%\" for $val percent, or \"${sign}$(awk -v a="$mag" 'BEGIN{printf "%g", a*100}')%\"" >&2
      return 1
    fi
  else
    echo "hued mod: '$val' is not a number" >&2
    return 1
  fi
  awk -v n="$n" 'BEGIN{printf "%g", n/100}'
}

# Prints its own error and returns 1 on failure.
_hued_degrees() {
  local val="${1%deg}"
  val="${val%°}"
  if [[ ! "$val" =~ ^[+-]?[0-9]+(\.[0-9]+)?$ ]]; then
    echo "hued mod: '$1' is not a number of degrees" >&2
    return 1
  fi
  printf '%s' "$val"
}

_HUED_OPS="darken lighten saturate desaturate rotate complement to-gray mix lightness saturation hue"

_hued_is_op() { [[ -n "$1" && " $_HUED_OPS " == *" $1 "* ]]; }

_hued_invert() {
  case "$1" in
    darken)     printf 'lighten' ;;
    lighten)    printf 'darken' ;;
    saturate)   printf 'desaturate' ;;
    desaturate) printf 'saturate' ;;
  esac
}

_hued_pastel() { pastel "$@" | pastel format hex; }

# Apply a chain of ops to a color, printing the resulting hex.
# Usage: _hued_mod_run <color> <op> [args...] [<op> [args...]]...
_hued_mod_run() {
  local color="$1"; shift
  local op raw amount deg other verb prop

  while [[ $# -gt 0 ]]; do
    op="$1"; shift
    case "$op" in
      darken|lighten|saturate|desaturate)
        [[ $# -gt 0 ]] || { echo "hued mod: $op requires an amount" >&2; return 1; }
        raw="$1"; shift
        amount=$(_hued_amount "$raw") || return 1
        if [[ "$amount" == -* ]]; then
          op=$(_hued_invert "$op")
          amount="${amount#-}"
        fi
        color=$(_hued_pastel "$op" "$amount" "$color") || return 1
        ;;
      rotate)
        [[ $# -gt 0 ]] || { echo "hued mod: rotate requires degrees" >&2; return 1; }
        raw="$1"; shift
        deg=$(_hued_degrees "$raw") || return 1
        # -- keeps a negative angle from being read as a pastel flag
        color=$(_hued_pastel rotate -- "$deg" "$color") || return 1
        ;;
      complement|to-gray)
        color=$(_hued_pastel "$op" "$color") || return 1
        ;;
      mix)
        [[ $# -gt 0 ]] || { echo "hued mod: mix requires a color" >&2; return 1; }
        other="$1"; shift
        amount="0.5"
        if [[ $# -gt 0 ]] && ! _hued_is_op "$1"; then
          raw="$1"; shift
          amount=$(_hued_amount "$raw") || return 1
          if [[ "$amount" == -* ]]; then
            echo "hued mod: mix ratio cannot be negative" >&2
            return 1
          fi
        fi
        color=$(_hued_pastel mix --fraction "$amount" "$other" "$color") || return 1
        ;;
      lightness|saturation)
        [[ $# -gt 0 ]] || { echo "hued mod: $op requires a value" >&2; return 1; }
        raw="$1"; shift
        amount=$(_hued_amount "$raw") || return 1
        if [[ "$raw" == [+-]* ]]; then
          if [[ "$op" == "lightness" ]]; then verb="lighten"; else verb="saturate"; fi
          if [[ "$amount" == -* ]]; then
            verb=$(_hued_invert "$verb")
            amount="${amount#-}"
          fi
          color=$(_hued_pastel "$verb" "$amount" "$color") || return 1
        else
          if [[ "$op" == "lightness" ]]; then prop="hsl-lightness"; else prop="hsl-saturation"; fi
          color=$(_hued_pastel set "$prop" "$amount" "$color") || return 1
        fi
        ;;
      hue)
        [[ $# -gt 0 ]] || { echo "hued mod: hue requires degrees" >&2; return 1; }
        raw="$1"; shift
        deg=$(_hued_degrees "$raw") || return 1
        if [[ "$raw" == [+-]* ]]; then
          color=$(_hued_pastel rotate -- "$deg" "$color") || return 1
        else
          color=$(_hued_pastel set hsl-hue "$deg" "$color") || return 1
        fi
        ;;
      *)
        echo "hued mod: unknown op '$op' (${_HUED_OPS// /, })" >&2
        return 1
        ;;
    esac
  done

  printf '%s' "$color"
}

_hued_read_stdin_color() {
  [[ -t 0 ]] && return 1
  local line
  IFS= read -r line || return 1
  line="${line//[[:space:]]/}"
  [[ -z "$line" ]] && return 1
  printf '%s' "$line"
}

_hued_set_key() {
  local key="$1" raw="$2" color line
  color="$(_hued_normalize_color "$raw")"
  line="${key}=${color}"
  # If the input was a recognized X11 name (not hex/none) that resolved to
  # #rrggbb, keep the original name as an inline comment for humans.
  local bare="${raw#\#}"
  if [[ ! "$bare" =~ ^[0-9a-fA-F]{3}$ && ! "$bare" =~ ^[0-9a-fA-F]{6}$ \
        && "$raw" != "none" && "$color" =~ ^#[0-9a-f]{6}$ ]]; then
    line="${line}  # ${raw}"
  fi
  if [[ -f .hued ]]; then
    grep -v "^${key}=" .hued > .hued.tmp || true
    printf '%s\n' "$line" >> .hued.tmp
    mv .hued.tmp .hued
  else
    printf "# https://github.com/orochi235/hued\n%s\n" "$line" > .hued
  fi
  echo "Set ${key} to ${color} in ${PWD}/.hued"
}

# Resolve a color value (6-hex, 3-hex shorthand, or X11 name) to bare rrggbb.
# Prints an empty string if it cannot be resolved.
_hued_resolve_hex() {
  local bare="${1#\#}"
  bare="${bare// /}"
  bare="${bare,,}"
  if [[ "$bare" =~ ^[0-9a-f]{6}$ ]]; then
    printf '%s' "$bare"
  elif [[ "$bare" =~ ^[0-9a-f]{3}$ ]]; then
    printf '%s' "${bare:0:1}${bare:0:1}${bare:1:1}${bare:1:1}${bare:2:1}${bare:2:1}"
  else
    local hex
    hex=$({ grep -m1 "\[${bare}\]=" "$_HUED_NAMES_FILE" 2>/dev/null || true; } | cut -d= -f2)
    printf '%s' "${hex#\#}"
  fi
}

# Emit OSC 10/11 escapes for the given bg/fg values to stdout.
# Empty value -> reset escape for that channel.
_hued_emit_osc() {
  local bg="$1" fg="$2" hex
  if [[ -n "$bg" ]]; then
    hex="$(_hued_resolve_hex "$bg")"
    [[ -n "$hex" ]] && printf '\e]11;rgb:%s/%s/%s\a' "${hex:0:2}" "${hex:2:2}" "${hex:4:2}"
  else
    printf '\e]111;\a'
  fi
  if [[ -n "$fg" ]]; then
    hex="$(_hued_resolve_hex "$fg")"
    [[ -n "$hex" ]] && printf '\e]10;rgb:%s/%s/%s\a' "${hex:0:2}" "${hex:2:2}" "${hex:4:2}"
  else
    printf '\e]110;\a'
  fi
}

# Repaint the terminal to match the nearest .hued (plus env overrides).
# Writes to ${HUED_TTY:-/dev/tty}; silent no-op if that cannot be opened.
_hued_apply_cmd() {
  local bg="" fg="" dir="$PWD"
  while [[ "$dir" != / && -n "$dir" ]]; do
    if [[ -f "$dir/.hued" ]]; then
      bg=$({ grep -m1 '^background=' "$dir/.hued" || true; } | cut -d= -f2 | awk '{print $1}' | tr '[:upper:]' '[:lower:]')
      fg=$({ grep -m1 '^foreground=' "$dir/.hued" || true; } | cut -d= -f2 | awk '{print $1}' | tr '[:upper:]' '[:lower:]')
      [[ -n "$bg" || -n "$fg" ]] && break
    fi
    dir="${dir%/*}"
  done

  if [[ -n "${HUED_BACKGROUND:-}" ]]; then
    bg=$(printf '%s' "$HUED_BACKGROUND" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  fi
  if [[ -n "${HUED_FOREGROUND:-}" ]]; then
    fg=$(printf '%s' "$HUED_FOREGROUND" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  fi
  [[ "$bg" == "none" ]] && bg=""
  [[ "$fg" == "none" ]] && fg=""

  local target="${HUED_TTY:-/dev/tty}"
  { exec 3>"$target"; } 2>/dev/null || return 0
  _hued_emit_osc "$bg" "$fg" >&3
  exec 3>&-
}

case "${1:-}" in
  "")
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    grep '^background=\|^foreground=' "$file"
    ;;

  -v|--version|version)
    echo "hued $HUED_VERSION"
    ;;

  where)
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    echo "$file"
    ;;

  apply)
    _hued_apply_cmd
    ;;

  resolve)
    [[ -z "${2:-}" ]] && { echo "Usage: hued resolve <color>" >&2; exit 1; }
    command -v pastel >/dev/null 2>&1 || {
      echo "hued resolve: requires 'pastel' (brew install pastel)" >&2
      exit 1
    }
    pastel format hex "$2"
    ;;

  get)
    case "${2:-}" in
      bg|background) key="background" ;;
      fg|foreground) key="foreground" ;;
      *) echo "Usage: hued get [bg|fg]" >&2; exit 1 ;;
    esac
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    raw=$({ grep -m1 "^${key}=" "$file" || true; } | cut -d= -f2 | awk '{print $1}')
    [[ -z "$raw" ]] && exit 1
    command -v pastel >/dev/null 2>&1 || {
      echo "hued get: requires 'pastel' (brew install pastel)" >&2
      exit 1
    }
    pastel format hex "$raw"
    ;;

  mod|adjust)
    shift
    key="background"
    # With no channel given, an unknown leading token may have been meant as one.
    expected="expected bg|fg or one of: ${_HUED_OPS// /, }"
    case "${1:-}" in
      bg|background) key="background"; shift; expected="${_HUED_OPS// /, }" ;;
      fg|foreground) key="foreground"; shift; expected="${_HUED_OPS// /, }" ;;
    esac
    [[ $# -gt 0 ]] || { echo "Usage: hued mod [bg|fg] <op> [<args>...]" >&2; exit 1; }
    _hued_is_op "$1" || {
      echo "hued mod: unknown op '$1' ($expected)" >&2
      exit 1
    }
    command -v pastel >/dev/null 2>&1 || {
      echo "hued mod: requires 'pastel' (brew install pastel)" >&2
      exit 1
    }
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    current=$({ grep -m1 "^${key}=" "$file" || true; } | cut -d= -f2 | awk '{print $1}')
    [[ -z "$current" ]] && { echo "hued mod: ${key} not set in $file" >&2; exit 1; }
    new=$(_hued_mod_run "$current" "$@") || exit 1
    _hued_set_key "$key" "$new"
    _hued_apply_cmd
    ;;

  set)
    case "${2:-}" in
      bg|background)
        color="${3:-}"
        [[ -z "$color" ]] && { color="$(_hued_read_stdin_color)" || color=""; }
        [[ -z "$color" ]] && { echo "Usage: hued set bg <color>" >&2; exit 1; }
        _hued_set_key "background" "$color"
        ;;
      fg|foreground)
        color="${3:-}"
        [[ -z "$color" ]] && { color="$(_hued_read_stdin_color)" || color=""; }
        [[ -z "$color" ]] && { echo "Usage: hued set fg <color>" >&2; exit 1; }
        _hued_set_key "foreground" "$color"
        ;;
      "")
        color="$(_hued_read_stdin_color)" || color=""
        [[ -z "$color" ]] && { echo "Usage: hued set [bg|fg] <color>" >&2; exit 1; }
        _hued_set_key "background" "$color"
        ;;
      *)
        _hued_set_key "background" "$2"
        ;;
    esac
    _hued_apply_cmd
    ;;

  fork)
    if [[ -f .hued ]]; then
      echo "hued fork: ${PWD}/.hued already exists" >&2
      exit 1
    fi
    ancestor=""
    dir="${PWD%/*}"
    while [[ "$dir" != / && -n "$dir" ]]; do
      if [[ -f "$dir/.hued" ]]; then
        ancestor="$dir/.hued"
        break
      fi
      dir="${dir%/*}"
    done
    [[ -z "$ancestor" && -f "/.hued" ]] && ancestor="/.hued"
    [[ -z "$ancestor" ]] && { echo "hued fork: no ancestor .hued to inherit from" >&2; exit 1; }
    bg=$({ grep -m1 '^background=' "$ancestor" || true; } | cut -d= -f2 | awk '{print $1}')
    fg=$({ grep -m1 '^foreground=' "$ancestor" || true; } | cut -d= -f2 | awk '{print $1}')
    if [[ -z "$bg" && -z "$fg" ]]; then
      echo "hued fork: ancestor $ancestor has no background or foreground to inherit" >&2
      exit 1
    fi
    if [[ -n "$bg" ]]; then _hued_set_key "background" "$bg"; fi
    if [[ -n "$fg" ]]; then _hued_set_key "foreground" "$fg"; fi
    _hued_apply_cmd
    ;;

  unset)
    case "${2:-}" in
      bg|background) key="background" ;;
      fg|foreground) key="foreground" ;;
      *) echo "Usage: hued unset [bg|fg]" >&2; exit 1 ;;
    esac
    [[ -f .hued ]] || { echo "hued unset: no .hued in ${PWD}" >&2; exit 1; }
    if ! grep -q "^${key}=" .hued; then
      echo "hued unset: ${key} not set in ${PWD}/.hued" >&2
      exit 1
    fi
    grep -v "^${key}=" .hued > .hued.tmp || true
    mv .hued.tmp .hued
    echo "Unset ${key} in ${PWD}/.hued"
    _hued_apply_cmd
    ;;

  pack)
    shift
    dir="."
    if [[ -n "${1:-}" && "$1" != -* ]]; then
      dir="$1"
      shift
    fi
    dir="$(cd "$dir" && pwd)"
    output=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -o) output="${2:-}"; shift 2 ;;
        *) echo "Usage: hued pack [<dir>] [-o <file>]" >&2; exit 1 ;;
      esac
    done
    result=$(python3 - "$dir" <<'PYEOF'
import os, json, sys

root_dir = sys.argv[1]
result = {}
for dirpath, _, files in os.walk(root_dir):
    if '.hued' in files:
        config = {}
        with open(os.path.join(dirpath, '.hued')) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                if '=' in line:
                    k, v = line.split('=', 1)
                    # value is the first whitespace-delimited token; the rest
                    # (e.g. "  # aliceblue") is an inline comment, dropped here.
                    v = v.split()
                    if v:
                        config[k.strip()] = v[0]
        if config:
            result[dirpath] = config
print(json.dumps(result, indent=2))
PYEOF
)
    if [[ -n "$output" ]]; then
      echo "$result" > "$output"
      echo "Wrote $(echo "$result" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))') entries to $output"
    else
      echo "$result"
    fi
    ;;

  unpack)
    [[ -z "${2:-}" ]] && { echo "Usage: hued unpack <file> [--force]" >&2; exit 1; }
    file="$2"
    force=0
    [[ "${3:-}" == "--force" ]] && force=1
    python3 - "$file" "$force" "$_HUED_NAMES_FILE" <<'PYEOF'
import os, json, re, sys

file, force, names_file = sys.argv[1], sys.argv[2] == '1', sys.argv[3]

# Load X11 name -> #rrggbb map from hued-names.sh so packed configs that
# carry named colors get normalized to hex on unpack.
names = {}
try:
    with open(names_file) as f:
        for line in f:
            m = re.match(r'\s*\[([^\]]+)\]=(#[0-9a-fA-F]{6})', line)
            if m:
                names[m.group(1)] = m.group(2).lower()
except OSError:
    pass

def normalize(value):
    """Return (hex_or_original, original_name_or_None)."""
    v = value.split()[0] if value.split() else value
    bare = v[1:] if v.startswith('#') else v
    if re.fullmatch(r'[0-9a-fA-F]{3}', bare):
        bare = ''.join(c * 2 for c in bare)
    if re.fullmatch(r'[0-9a-fA-F]{6}', bare):
        return '#' + bare.lower(), None
    if v.lower() == 'none':
        return 'none', None
    hexv = names.get(v)
    if hexv:
        return hexv, v
    return v, None

with open(file) as f:
    data = json.load(f)

for dirpath, config in data.items():
    hued_path = os.path.join(dirpath, '.hued')
    if os.path.exists(hued_path) and not force:
        print(f'Skipping {hued_path} (already exists, use --force to overwrite)', file=sys.stderr)
        continue
    os.makedirs(dirpath, exist_ok=True)
    with open(hued_path, 'w') as f:
        f.write('# https://github.com/orochi235/hued\n')
        for k, v in config.items():
            hexv, name = normalize(v)
            if name:
                f.write(f'{k}={hexv}  # {name}\n')
            else:
                f.write(f'{k}={hexv}\n')
    print(f'Wrote {hued_path}')
PYEOF
    _hued_apply_cmd
    ;;

  -i|--interactive)
    _picker="$(dirname "$0")/hued-pick"
    if [[ ! -f "$_picker" ]]; then
      echo "hued -i: hued-pick not found at $_picker" >&2
      exit 1
    fi
    _current_bg=""
    _current_fg=""
    if _file=$(_hued_find 2>/dev/null); then
      _raw_bg=$({ grep -m1 '^background=' "$_file" || true; } | cut -d= -f2 | awk '{print $1}')
      _raw_fg=$({ grep -m1 '^foreground=' "$_file" || true; } | cut -d= -f2 | awk '{print $1}')
      [[ -z "$_raw_bg" ]] || _current_bg=$(_hued_normalize_color "$_raw_bg")
      [[ -z "$_raw_fg" ]] || _current_fg=$(_hued_normalize_color "$_raw_fg")
    fi
    _live_flag=""
    for _arg in "$@"; do [[ "$_arg" == "--live" ]] && _live_flag="--live" && break; done
    _tmpfile=$(mktemp)
    "$_picker" \
      ${_current_bg:+--bg "$_current_bg"} \
      ${_current_fg:+--fg "$_current_fg"} \
      ${_live_flag:+"$_live_flag"} --output "$_tmpfile" || { rm -f "$_tmpfile"; exit 0; }
    while IFS='=' read -r _key _value; do
      case "$_key" in
        background) _hued_set_key "background" "$_value" ;;
        foreground) _hued_set_key "foreground" "$_value" ;;
      esac
    done < "$_tmpfile"
    rm -f "$_tmpfile"
    ;;

  *)
    echo "Usage: hued [where | get [bg|fg] | set [bg|fg] <color> | unset [bg|fg] | fork | mod [bg|fg] <op> [<args>...] | resolve <color> | pack [<dir>] [-o <file>] | unpack <file> [--force] | -i [--live] | -v]" >&2
    exit 1
    ;;
esac
